# Copy to .env.local and point at the MSRF FastAPI backend.
# The Vite dev server proxies /api and /media to this address (see vite.config.ts).
VITE_API_PROXY_TARGET=http://localhost:8000

# Remote backend (e.g. production https://api.malabarchallengersfc.com): also set the Origin the
# backend trusts, which the dev proxy sends instead of http://localhost:5173.
# VITE_API_PROXY_ORIGIN=https://admin.malabarchallengersfc.com
